{:tasks
 {dev          {:doc  "App mode: app/public/index.html with EDN API, websocket push, hot reload (PORT, default 8090)"
                :task (shell {:dir "app"} "bb server.clj")}
  dev-full     {:doc  "App mode plus SSR at /ssr/profiles and an nREPL into the page on :1339 (needs Java once to resolve the deps)"
                :task (shell {:dir "app"} "bb --config dev-full.edn server.clj")}
  serve-static {:doc  "Static mode: serve app/public/ - open /static.html (PORT, default 8092)"
                :task (shell "bb scripts/serve_static.clj app/public 8092")}
  build-single {:doc  "Generate single-file/index.html from app/ (inlined cljs + embedded assets)"
                :task (load-file "scripts/build_single.clj")}
  test         {:doc  "Browser-free unit tests of logic.cljc (reducer, routing, theming) and views.cljc (no Java, no deps)"
                :task (load-file "test/unit_test.clj")}
  serve-single {:doc  "Single-file mode: serve single-file/ (PORT, default 8091)"
                :task (shell "bb scripts/serve_static.clj single-file 8091")}}}
